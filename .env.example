# Docker Compose 环境变量
#
# 使用方式:
#   cp .env.example .env
#   然后把下面的 JWT_SECRET 换成你自己生成的随机值
#
# 生成 JWT_SECRET (二选一):
#   openssl rand -base64 48
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
#
# 注意: .env 已被 .gitignore 忽略，不会提交到仓库。
#       更换 JWT_SECRET 会导致所有已签发的 token 失效（需重新登录）。

JWT_SECRET=请替换为随机密钥_至少32字节_例如_openssl_rand_base64_48_的输出

# ---------------------------------------------------------------------------
# 站内知识问答（RAG）
# ---------------------------------------------------------------------------
#
# provider=mock（默认）
#   不调用外部大模型，用本地模拟实现按检索结果组织回答。
#   适合：本地开发、无 Key 时的功能演示、答辩现场无网络时兜底。
#
# provider=openai（启用真实大模型）
#   走 OpenAI 兼容协议（Chat Completions），以下服务均可直接接入：
#     DeepSeek     base-url: https://api.deepseek.com/v1          model: deepseek-chat
#     通义千问      base-url: https://dashscope.aliyuncs.com/compatible-mode/v1  model: qwen-plus
#     Ollama 本地   base-url: http://host.docker.internal:11434/v1   model: qwen2.5:1.5b
#
# 申请 DeepSeek key：https://platform.deepseek.com/api_keys
# 切换后需重建并重启后端：docker compose up -d --build backend
#
RAG_PROVIDER=mock
RAG_BASE_URL=https://api.deepseek.com/v1
RAG_MODEL=deepseek-chat
RAG_API_KEY=

# 单 IP 提问频率限制（分钟 / 天），用于控制大模型调用成本
RAG_RATE_LIMIT_PER_MINUTE=5
RAG_DAILY_LIMIT=100
